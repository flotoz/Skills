{
  "name": "flotoz-skills",
  "private": true,
  "description": "Curated agent skills by flotoz — quality tooling.",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "setup": "npm ci",
    "verify": "npm run verify:rules && npm run verify:docs",
    "verify:rules": "node scripts/check-repo.mjs",
    "verify:docs": "markdownlint-cli2 && prettier --check .",
    "fix:docs": "prettier --write . && markdownlint-cli2 --fix",
    "prepare": "husky",
    "build:skills": "node scripts/build-skills.mjs"
  },
  "lint-staged": {
    "*.md": [
      "prettier --write",
      "markdownlint-cli2 --fix"
    ],
    "*.{json,yml,yaml,mjs,js}": "prettier --write"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.10",
    "yaml": "2.9.1"
  }
}
